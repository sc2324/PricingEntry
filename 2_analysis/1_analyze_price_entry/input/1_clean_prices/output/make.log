. import excel using "`IN'/IQVIA_2011-2016.xlsx", firstrow clear
(181 vars, 128,167 obs)

. 
. * Rename quarter-measure columns to stubs rev_usd/rev_lcd/su + yq; drop the
. * rest (EURO, LCEURO, Units, Counting Units). import excel sanitizes headers
. * ('Q1 2011_US$ MNF' -> Q12011_USMNF) and keeps the original in the variable
. * label, so match on the label first and fall back to the sanitized name.
. foreach v of varlist _all {
  2.     local lab : variable label `v'
  3.     local stub ""
  4.     local y ""
  5.     local q ""
  6.     if regexm(`"`lab'"', "^Q([1-4]) (20[0-9][0-9])_(.+)$") {
  7.         local q = regexs(1)
  8.         local y = regexs(2)
  9.         local m = regexs(3)
 10.         if      `"`m'"' == "US$ MNF"        local stub "rev_usd"
 11.         else if `"`m'"' == "LC$ MNF"        local stub "rev_lcd"
 12.         else if `"`m'"' == "Standard Units" local stub "su"
 13.         else                                drop `v'
 14.     }
 15.     else if regexm("`v'", "^Q([1-4])(20[0-9][0-9])_(.+)$") {
 16.         local q = regexs(1)
 17.         local y = regexs(2)
 18.         local m = regexs(3)
 19.         if      "`m'" == "USMNF"         local stub "rev_usd"
 20.         else if "`m'" == "LCMNF"         local stub "rev_lcd"
 21.         else if "`m'" == "StandardUnits" local stub "su"
 22.         else                             drop `v'
 23.     }
 24.     if "`stub'" != "" rename `v' `stub'`y'`q'
 25. }

